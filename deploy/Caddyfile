{
	email {$TLS_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://{$API_DOMAIN}; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy web:80
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3000
}
