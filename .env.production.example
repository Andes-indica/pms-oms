# Docker Compose and TLS domains
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
TLS_EMAIL=operations@example.com
VITE_API_URL=https://api.example.com
PMS_ENV_FILE=.env.production

# API runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/pms_oms?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
BROKER_CREDENTIAL_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
CORS_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

ORDER_EXECUTION_WORKER_ENABLED=true
ORDER_EXECUTION_WORKER_INTERVAL_MS=1000
ORDER_EXECUTION_LOCK_TIMEOUT_MS=60000
ORDER_MONITOR_ENABLED=true
ORDER_MONITOR_INTERVAL_MS=10000
BROKER_HTTP_TIMEOUT_MS=7000
SHUTDOWN_TIMEOUT_MS=30000

MARKET_DATA_PROVIDER=http
MARKET_DATA_BASE_URL=https://quotes.example.com
MARKET_DATA_API_TOKEN=replace-with-provider-token
MARKET_DATA_REQUEST_TIMEOUT_MS=5000

# The host file is mounted at the container path below.
INSTRUMENT_MASTER_FILE=./config/instruments.json
INSTRUMENT_MASTER_PATH=/run/config/instruments.json
INSTRUMENT_MASTER_STRICT=true
