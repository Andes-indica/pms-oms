generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
  runtime="bun"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PORTFOLIO_MANAGER
  OPERATIONS
  VIEWER
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  clients Client[]
  basketOrders BasketOrder[]
  auditLogs AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PORTFOLIO_MANAGER)

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id    String @id @default(cuid())
  name  String
  email String?

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id])

  brokerAccounts BrokerAccount[]
  portfolios Portfolio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrokerAccount {
  id String @id @default(cuid())

  broker       String
  accountId    String
  accountLabel String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([broker, accountId])
}
enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  SUBMITTED
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum AuditAction {
  ORDER_CREATED
  ORDER_SUBMITTED
  ORDER_FILLED
  ORDER_CANCELLED
  ORDER_REJECTED
  ORDER_SYNCED

  BASKET_CREATED
  BASKET_SUBMITTED
  BASKET_CANCELLED
}

model Portfolio {
  id       String @id @default(cuid())
  name     String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  cashBalance Decimal @default(0) @db.Decimal(18, 4)

  holdings Holding[]
  orders   Order[]

  riskLimit RiskLimit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holding {
  id       String @id @default(cuid())

  symbol   String
  exchange String
  quantity Int

  averagePrice Decimal @db.Decimal(18, 4)

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portfolioId, symbol, exchange])
}

model Order {
  id String @id @default(cuid())

  symbol   String
  exchange String

  side      OrderSide
  orderType OrderType
  status    OrderStatus @default(PENDING)

  quantity Int

  limitPrice Decimal? @db.Decimal(18, 4)

  brokerOrderId String? @unique
  basketOrderId String?
  basketOrder BasketOrder? @relation(fields: [basketOrderId], references: [id])

  filledQuantity   Int      @default(0)
  averageFillPrice Decimal? @db.Decimal(18, 4)
  realizedPnl      Decimal? @db.Decimal(18,4)
  filledAt         DateTime?

  estimatedPrice   Decimal? @db.Decimal(18, 4)
  reservedCash     Decimal  @default(0) @db.Decimal(18, 4)
  reservedQuantity Int      @default(0)

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])

  brokerAccountId String
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id])

  action AuditAction

  entityType String
  entityId   String

  message String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([firmId])
}

enum AllocationMethod {
  FIXED_QUANTITY
  EQUAL_QUANTITY
  PERCENTAGE
}

enum BasketOrderStatus {
  PENDING
  PARTIALLY_SUBMITTED
  SUBMITTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

model BasketOrder {
  id String @id @default(cuid())

  name String?

  symbol   String
  exchange String

  side      OrderSide
  orderType OrderType

  limitPrice Decimal? @db.Decimal(18, 4)

  totalQuantity Int

  allocationMethod AllocationMethod

  status BasketOrderStatus @default(PENDING)

  firmId String
  firm   Firm @relation(fields: [firmId], references: [id])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
}

model RiskLimit {
  id String @id @default(cuid())

  portfolioId String @unique
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])

  maxOrderQuantity Int?
  maxOrderValue    Decimal? @db.Decimal(18, 4)

  maxPositionQuantity Int?
  maxPositionValue    Decimal? @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestrictedSecurity {
  id String @id @default(cuid())

  symbol   String
  exchange String

  reason String?

  createdAt DateTime @default(now())

  @@unique([symbol, exchange])
}
